# ============================================================================
# Copy this file to  .env  and paste your Anthropic key below. That's the only
# edit needed. Everything else is pre-configured with working, keyless defaults.
#
#   cp .env.example .env         # (Windows: copy .env.example .env)
#   pip install -r requirements-dev.txt
#   python run.py                # THE BACKROOMS opens in your browser
#
# The game runs even with NO key (the Architect falls back to an offline composer);
# a key just turns on the live Claude architect.
# ============================================================================

# --- API ---
ENVIRONMENT=development
API_PREFIX=/v1

# --- Architect (Claude composes the game) ---
ARCHITECT_PROVIDER=anthropic
ARCHITECT_MODEL=claude-opus-4-8
# Paste your Anthropic API key here (get one at https://console.anthropic.com).
# Leave blank to play with the offline mock composer.
ANTHROPIC_API_KEY=

# --- Assets: real, keyless open libraries (Poly Haven CC0 + CC0 packs) ---
ASSET_SOURCE=libraries
ASSET_LIBRARIES=polyhaven,cc0pack
# Optional — add "freesound"/"sketchfab" to ASSET_LIBRARIES after pasting a token:
FREESOUND_API_KEY=
SKETCHFAB_API_KEY=

# --- Generative asset provider (offline mock; "vertex" needs Google Cloud) ---
ASSET_PROVIDER=mock
GCP_PROJECT=
GCP_LOCATION=us-central1
VERTEX_TEXT_MODEL=gemini-2.5-flash
VERTEX_IMAGE_MODEL=gemini-2.5-flash-image
VERTEX_MUSIC_MODEL=lyria-002
AUDIO_PROVIDER=none
GOOGLE_APPLICATION_CREDENTIALS=
GCS_BUCKET=

# --- EEG signal processing ---
EEG_SAMPLE_RATE_HZ=256
EEG_WINDOW_SECONDS=2

# --- Learning (per-player model persists here) ---
PLAYER_DATA_DIR=data/players

# --- Safety back-off (sustained stress above this eases the experience) ---
STRESS_SAFETY_CEILING=0.9
